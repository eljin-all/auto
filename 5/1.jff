<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>grammar</type>
	<!-- S -> V = E -->
	<production><left>S</left><right>V=E</right></production>
	<!-- Additive -->
	<production><left>E</left><right>TA</right></production>
	<production><left>A</left><right>+TA</right></production>
	<production><left>A</left><right>-TA</right></production>
	<production><left>A</left><right/></production>
	<!-- Multiplicative -->
	<production><left>T</left><right>UB</right></production>
	<production><left>B</left><right>*UB</right></production>
	<production><left>B</left><right>/UB</right></production>
	<production><left>B</left><right/></production>
	<!-- Unary minus -->
	<production><left>U</left><right>-U</right></production>
	<production><left>U</left><right>P</right></production>
	<!-- Primary -->
	<production><left>P</left><right>(E)</right></production>
	<production><left>P</left><right>V</right></production>
	<production><left>P</left><right>N</right></production>
	<!-- Exponential Real Constants: I.IeH -->
	<production><left>N</left><right>I.IeH</right></production>
	<production><left>H</left><right>+I</right></production>
	<production><left>H</left><right>-I</right></production>
	<production><left>H</left><right>I</right></production>
	<!-- Digits sequence I -> DK, K -> DK | lambda -->
	<production><left>I</left><right>DK</right></production>
	<production><left>K</left><right>DK</right></production>
	<production><left>K</left><right/></production>
	<!-- Variables a-d -->
	<production><left>V</left><right>a</right></production>
	<production><left>V</left><right>b</right></production>
	<production><left>V</left><right>c</right></production>
	<production><left>V</left><right>d</right></production>
	<!-- Digits 0-9 -->
	<production><left>D</left><right>0</right></production>
	<production><left>D</left><right>1</right></production>
	<production><left>D</left><right>2</right></production>
	<production><left>D</left><right>3</right></production>
	<production><left>D</left><right>4</right></production>
	<production><left>D</left><right>5</right></production>
	<production><left>D</left><right>6</right></production>
	<production><left>D</left><right>7</right></production>
	<production><left>D</left><right>8</right></production>
	<production><left>D</left><right>9</right></production>
</structure>