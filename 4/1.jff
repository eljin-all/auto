<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>grammar</type>
	<!-- S -> V = E -->
	<production><left>S</left><right>VU</right></production>
	<production><left>U</left><right>QE</right></production>
	<!-- Бинарные и унарные операции, скобки, вещественные числа -->
	<production><left>E</left><right>EW</right></production>
	<production><left>W</left><right>PT</right></production>
	<production><left>E</left><right>EX</right></production>
	<production><left>X</left><right>MT</right></production>
	<production><left>E</left><right>TY</right></production>
	<production><left>Y</left><right>KF</right></production>
	<production><left>E</left><right>TZ</right></production>
	<production><left>Z</left><right>JF</right></production>
	<production><left>E</left><right>MF</right></production>
	<production><left>E</left><right>LB</right></production>
	<production><left>B</left><right>ER</right></production>
	<production><left>E</left><right>IC</right></production>
	<production><left>C</left><right>OI</right></production>
	<!-- T-уровень -->
	<production><left>T</left><right>TY</right></production>
	<production><left>T</left><right>TZ</right></production>
	<production><left>T</left><right>MF</right></production>
	<production><left>T</left><right>LB</right></production>
	<production><left>T</left><right>IC</right></production>
	<!-- F-уровень -->
	<production><left>F</left><right>MF</right></production>
	<production><left>F</left><right>LB</right></production>
	<production><left>F</left><right>IC</right></production>
	<!-- Составные части чисел -->
	<production><left>I</left><right>DI</right></production>
	<!-- Переменные строго от a до d -->
	<production><left>V</left><right>a</right></production>
	<production><left>V</left><right>b</right></production>
	<production><left>V</left><right>c</right></production>
	<production><left>V</left><right>d</right></production>
	<production><left>E</left><right>a</right></production>
	<production><left>E</left><right>b</right></production>
	<production><left>E</left><right>c</right></production>
	<production><left>E</left><right>d</right></production>
	<production><left>T</left><right>a</right></production>
	<production><left>T</left><right>b</right></production>
	<production><left>T</left><right>c</right></production>
	<production><left>T</left><right>d</right></production>
	<production><left>F</left><right>a</right></production>
	<production><left>F</left><right>b</right></production>
	<production><left>F</left><right>c</right></production>
	<production><left>F</left><right>d</right></production>
	<!-- Цифры 0-9 (используются исключительно через D и I для сборки вещественных констант) -->
	<production><left>D</left><right>0</right></production>
	<production><left>D</left><right>1</right></production>
	<production><left>D</left><right>2</right></production>
	<production><left>D</left><right>3</right></production>
	<production><left>D</left><right>4</right></production>
	<production><left>D</left><right>5</right></production>
	<production><left>D</left><right>6</right></production>
	<production><left>D</left><right>7</right></production>
	<production><left>D</left><right>8</right></production>
	<production><left>D</left><right>9</right></production>
	<production><left>I</left><right>0</right></production>
	<production><left>I</left><right>1</right></production>
	<production><left>I</left><right>2</right></production>
	<production><left>I</left><right>3</right></production>
	<production><left>I</left><right>4</right></production>
	<production><left>I</left><right>5</right></production>
	<production><left>I</left><right>6</right></production>
	<production><left>I</left><right>7</right></production>
	<production><left>I</left><right>8</right></production>
	<production><left>I</left><right>9</right></production>
	<!-- Символы операций и разделители -->
	<production><left>Q</left><right>=</right></production>
	<production><left>P</left><right>+</right></production>
	<production><left>M</left><right>-</right></production>
	<production><left>K</left><right>*</right></production>
	<production><left>J</left><right>/</right></production>
	<production><left>L</left><right>(</right></production>
	<production><left>R</left><right>)</right></production>
	<production><left>O</left><right>.</right></production>
</structure>